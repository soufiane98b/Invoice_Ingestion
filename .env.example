# --- Gemini (Google AI Studio, palier Free, SANS activer le billing) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Google Drive + Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# Client OAuth "Application de bureau" + jeton après : python -m app.google_login
# En Cloud Run : coller le JSON de token.json sur une ligne dans GOOGLE_TOKEN_JSON
GOOGLE_OAUTH_CLIENT_JSON=./oauth-client.json
GOOGLE_TOKEN_JSON=./token.json
SPREADSHEET_ID=1kr2GXsZsv8NxdydHc97kK_ELBGc2QImBLT-5ZVmprb4
# gid de l'onglet ApexData (dans l'URL : #gid=...)
SHEET_GID=1923965794
DRIVE_FOLDER_ID=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-long-random
# Secret de l'app Meta (Paramètres → Informations de base) — signature du webhook
WHATSAPP_APP_SECRET=
# Ton numéro perso, chiffres uniquement avec indicatif, ex. 2126XXXXXXXX
ALLOWED_WHATSAPP_NUMBER=

# --- App ---
# En prod Cloud Run : URL publique https://….run.app (sans slash final)
APP_PUBLIC_URL=
INTERNAL_TOKEN=change-me-internal
LOG_LEVEL=INFO
